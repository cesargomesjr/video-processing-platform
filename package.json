{
  "name": "video-processing-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma distribuída de processamento de vídeos (FIAP X)",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . --max-warnings=0 && npm run lint:architecture",
    "lint:architecture": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspace @fiapx/api && npm run build --workspace @fiapx/worker",
    "start:api": "npm run start:prod --workspace @fiapx/api",
    "start:worker": "npm run start --workspace @fiapx/worker",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:cov": "jest --coverage",
    "compose:up": "docker compose -f infra/docker-compose.yml up -d"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.24.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/testing": "^11.2.6",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "supertest": "^7.3.0",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1",
    "zod": "^3.25.76"
  }
}
